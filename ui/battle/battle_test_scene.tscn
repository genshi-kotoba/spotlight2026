theme_override_font_sizes/font_size = 16
text = "玩家回合开始：请选择手牌编排到出牌区"
horizontal_alignment = 1

[node name="PileModal" type="Control" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="PileModalShade" type="ColorRect" parent="PileModal"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0, 0, 0, 0.72)

[node name="Window" type="PanelContainer" parent="PileModal"]
layout_mode = 0
offset_left = 390.0
offset_top = 145.0
offset_right = 1530.0
offset_bottom = 930.0
theme_override_styles/panel = SubResource("ModalPanel")

[node name="Column" type="VBoxContainer" parent="PileModal/Window"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="PileModal/Window/Column"]
layout_mode = 2

[node name="PileTitle" type="Label" parent="PileModal/Window/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.909804, 0.705882, 0.333333, 1)
theme_override_font_sizes/font_size = 30
text = "抽牌堆（0 张）"

[node name="ClosePileButton" type="Button" parent="PileModal/Window/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(100, 48)
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("ButtonNormal")
theme_override_styles/hover = SubResource("ButtonHover")
text = "关闭"

[node name="Scroll" type="ScrollContainer" parent="PileModal/Window/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="PileGrid" type="GridContainer" parent="PileModal/Window/Column/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 22
theme_override_constants/v_separation = 18
columns = 5
