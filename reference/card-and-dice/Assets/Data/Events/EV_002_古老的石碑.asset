  m_Name: "EV_002_\u53E4\u8001\u7684\u77F3\u7891"
  m_EditorClassIdentifier: 
  eventId: EV_002
  title: "\u53E4\u8001\u7684\u77F3\u7891"
  description: "\u534A\u622A\u5E03\u6EE1\u82D4\u85D3\u7684\u77F3\u7891\u7ACB\u5728\u8DEF\u53E3\uFF0C\u7891\u9762\u523B\u7740\u6A21\u7CCA\u7684\u53E4\u8001\u6587\u5B57\u3002\u77F3\u5934\u8FB9\u7F18\u6709\u88AB\u4EBA\u529B\u632A\u52A8\u8FC7\u7684\u75D5\u8FF9\u3002"
  once: 1
  options:
  - optionText: "\u8FA8\u8BA4\u7891\u6587"
    checkType: 3
    difficulty: 3
    success:
      flavorText: "\u4F60\u8BA4\u51FA\u8FD9\u662F\u524D\u4EBA\u7559\u4E0B\u7684\u63A2\u8DEF\u7B14\u8BB0\uFF1A\u9644\u8FD1\u9AB0\u5B50\u5BCC\u96C6\u7684\u65B9\u4F4D\u88AB\u5708\u4E86\u51FA\u6765\u3002"
      hpChange: 0
      energyChange: 1
      diceChange: 0
      addCards: []
    failure:
      flavorText: "\u6587\u5B57\u5728\u4F60\u773C\u91CC\u6405\u6210\u4E00\u56E2\u4E71\u7801\uFF0C\u4F60\u53EA\u8BB0\u4F4F\u4E86\u51E0\u7B14\u65E0\u610F\u4E49\u7684\u6D82\u9E26\u3002"
      hpChange: 0
      energyChange: 0
      diceChange: 0
      addCards: []
  - optionText: "\u63A8\u5F00\u77F3\u7891"
    checkType: 1
    difficulty: 5
    success:
      flavorText: "\u4F60\u53D1\u529B\u63A8\u5F00\u77F3\u7891\uFF0C\u5E95\u4E0B\u538B\u7740\u4E00\u5C0F\u888B\u80FD\u91CF\u7ED3\u6676\uFF0C\u770B\u6765\u524D\u4EBA\u8FD8\u85CF\u4E86\u70B9\u79C1\u8D27\u3002"
      hpChange: 0
      energyChange: 2
      diceChange: 0
      addCards: []
    failure:
      flavorText: "\u77F3\u7891\u7EB9\u4E1D\u4E0D\u52A8\uFF0C\u4F60\u53CD\u800C\u95EA\u4E86\u8170\uFF0C\u767D\u8D39\u529B\u6C14\u3002"
      hpChange: 0
      energyChange: 0
      diceChange: -1
      addCards: []
  - optionText: "\u4E0D\u611F\u5174\u8DA3\uFF0C\u7EE7\u7EED\u8D76\u8DEF"
    checkType: 0
    difficulty: 4
    success:
      flavorText: "\u77F3\u7891\u9759\u9759\u7ACB\u5728\u539F\u5730\uFF0C\u76EE\u9001\u4F60\u79BB\u5F00\u3002"
      hpChange: 0
