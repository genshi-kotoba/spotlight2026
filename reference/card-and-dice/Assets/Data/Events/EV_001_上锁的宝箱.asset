  options:
  - optionText: "\u64AC\u5F00\u5B83"
    checkType: 2
    difficulty: 4
    success:
      flavorText: "\u9501\u82AF\u5494\u54D2\u4E00\u58F0\u5F39\u5F00\uFF0C\u7BB1\u5B50\u91CC\u8EBA\u7740\u4E00\u74F6\u8FD8\u5192\u7740\u70ED\u6C14\u7684\u836F\u6C34\u548C\u51E0\u679A\u80FD\u91CF\u6C34\u6676\u3002"
      endEvent: 1
      hpChange: 3
      energyChange: 2
      diceChange: 0
      addCards: []
    failure:
      flavorText: "\u64AC\u68CD\u6253\u6ED1\uFF0C\u9501\u5B54\u5D29\u51FA\u7684\u94C1\u7247\u5212\u4F24\u4E86\u4F60\u7684\u624B\u80CC\uFF0C\u60CA\u52A8\u4E86\u4EC0\u4E48\u2026\u2026\u7BB1\u5B50\u5361\u6B7B\u4E86\u3002"
      endEvent: 0
      hpChange: -2
      energyChange: 0
      diceChange: 0
      addCards: []
  - optionText: "\u7ED5\u9053\u79BB\u5F00"
