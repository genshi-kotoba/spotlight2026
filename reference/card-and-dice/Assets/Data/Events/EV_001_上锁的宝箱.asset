      flavorText: "\u4F60\u51B3\u5B9A\u4E0D\u53BB\u62DB\u60F9\u53EF\u80FD\u5F15\u6765\u654C\u4EBA\u7684\u52A8\u9759\uFF0C\u7ED5\u5F00\u4E86\u8349\u4E1B\u3002"
