  eventId: EV_001
  title: "\u4E0A\u9501\u7684\u5B9D\u7BB1"
  description: "\u8DEF\u8FB9\u8349\u4E1B\u91CC\u534A\u57CB\u7740\u4E00\u53EA\u9EC4\u94DC\u9576\u8FB9\u7684\u6728\u7BB1\uFF0C\u9501\u5B54\u9508\u8FF9\u6591\u6591\u3002\u4F60\u53EF\u4EE5\u5192\u9669\u64AC\u5F00\u5B83\uFF0C\u6216\u8005\u5E72\u8106\u7ED5\u9053\u79BB\u5F00\u3002"
